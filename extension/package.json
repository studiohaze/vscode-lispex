{
  "name": "lispex",
  "displayName": "Lispex",
  "description": "Lispex errors as you type, formatting, symbols, definitions, and built-in completion and hover.",
  "version": "0.3.1",
  "publisher": "studiohaze",
  "author": "Studio Haze Inc.",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "homepage": "https://www.lispex.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/studiohaze/vscode-lispex"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:lispex"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lispex",
    "lspx",
    "scheme",
    "lisp",
    "r7rs"
  ],
  "scripts": {
    "test": "node --test test/formatter-client.test.mjs",
    "test:editor": "node test/run-editor.cjs",
    "build": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "languages": [
      {
        "id": "lispex",
        "aliases": [
          "Lispex",
          "lispex"
        ],
        "extensions": [
          ".lspx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "lispex",
        "scopeName": "source.lispex",
        "path": "./syntaxes/lispex.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Lispex",
      "properties": {
        "lispex.path": {
          "type": "string",
          "default": "lispex",
          "scope": "window",
          "description": "Path to the Native Lispex executable used for language support and formatting. Reload the window after changing it."
        },
        "lispex.format.executable": {
          "type": "string",
          "default": "lispex",
          "description": "Existing executable setting, used for language support and formatting when lispex.path is not set. Reload the window after changing it."
        },
        "lispex.format.timeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Maximum time in milliseconds allowed for one Lispex formatting request."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "8.1.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2"
  }
}
